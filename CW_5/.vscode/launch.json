{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Launch C++ Program",
        "type": "cppdbg",
        "request": "launch",
        "program": "${fileDirname}/${fileBasenameNoExtension}",
        "args": ["search", "--index", "texts/index_test.txt", "--input", "texts/input_test.txt", "--output", "texts/output.txt"], // Replace with your actual arguments
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "preLaunchTask": "Build C++ file"
      }
    ]
  }
  